rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: each authenticated user can read & write only their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // OTP verification records: authenticated users can read by email,
    // and can create/update their own record.
    match /otp_verifications/{email} {
      allow read, write: if request.auth != null;
    }

    // Inspection records: authenticated users can read & write their own inspections.
    match /inspections/{inspectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }
  }
}
