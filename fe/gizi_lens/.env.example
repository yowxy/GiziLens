# GiziLens detection backend (FastAPI, see ../../backend)
# Untuk backend lokal, gunakan http://10.0.2.2:8000 di emulator Android,
# http://localhost:8000 di simulator iOS, atau http://<IP-laptop>:8000 di HP.
BACKEND_BASE_URL=https://api.gizilens.web.id
BACKEND_API_KEY=

# Optional: Midtrans Sandbox credentials (gratis di https://dashboard.sandbox.midtrans.com)
# Jika kosong, aplikasi otomatis memakai Mode Simulator Midtrans Sandbox bawaan.
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
