# GiziLens detection backend (FastAPI, see ../../backend)
# Android emulator: http://10.0.2.2:8000
# Real device / iOS simulator: http://<LAN-IP>:8000 or http://localhost:8000
BACKEND_BASE_URL=http://10.0.2.2:8000
BACKEND_API_KEY=

# Optional: Midtrans Sandbox credentials (gratis di https://dashboard.sandbox.midtrans.com)
# Jika kosong, aplikasi otomatis memakai Mode Simulator Midtrans Sandbox bawaan.
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
