# ---- Server ----
APP_NAME=GiziLens Detection API
API_PREFIX=/api/v1
CORS_ORIGINS=*
MAX_UPLOAD_MB=20

# ---- Detection engine ----
# llm  = vision LLM via an OpenAI-compatible router
# onnx = local YOLO segmentation model (backend/models/best.onnx)
DETECTION_ENGINE=llm

# ---- LLM provider ----
SUMOPOD_API_KEY=
SUMOPOD_API_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=

# ---- PostgreSQL ----
# Firebase hanya untuk autentikasi; seluruh data aplikasi disimpan di PostgreSQL.
# Buat database: psql -U postgres -c "CREATE DATABASE gizilens;"
# Lalu jalankan migrasi: python scripts/init_db.py
DATABASE_URL=
DB_ECHO=
DB_POOL_SIZE=
DB_CONNECT_TIMEOUT=

# ---- Auth / subscription hook ----
# Set REQUIRE_API_KEY=true in production. Keys are comma separated.
REQUIRE_API_KEY=false
API_KEYS=

# ---- Firebase Admin (verifikasi Bearer token) ----
# Isi salah satu. Tanpa ini semua endpoint ber-Depends(require_admin) -> 503.
# Path ke file service account JSON dari Firebase Console.
FIREBASE_CREDENTIALS_FILE=
# Atau tempel isi JSON service account dalam satu baris.
FIREBASE_CREDENTIALS_JSON=
# UID Firebase yang boleh mengakses dashboard admin (pisahkan dengan koma).
FIREBASE_ADMIN_UIDS=

# ---- Midtrans Sandbox Payment Gateway ----
# Daftar gratis di https://dashboard.sandbox.midtrans.com untuk mendapat key uji coba
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ---- Firebase Admin SDK ----
FIREBASE_PROJECT_ID=gizilens-32aa6
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_UIDS=
