# ---- Server ----
APP_NAME=GiziLens Detection API
API_PREFIX=/api/v1
CORS_ORIGINS=*
MAX_UPLOAD_MB=20

# ---- Detection engine ----
# llm  = vision LLM via SumoPod (no local model needed)
# onnx = local YOLO segmentation model (backend/models/best.onnx)
DETECTION_ENGINE=llm

# ---- LLM provider ----
SUMOPOD_API_KEY=
SUMOPOD_API_BASE_URL=https://ai.sumopod.com/v1
LLM_MODEL=gemini/gemini-3.5-flash
LLM_TIMEOUT_SECONDS=45

# ---- ONNX model ----
ONNX_MODEL_PATH=models/best.onnx
ONNX_CLASSES_PATH=models/classes.json
ONNX_INPUT_SIZE=320
ONNX_CONF_THRESHOLD=0.25
ONNX_IOU_THRESHOLD=0.45
ONNX_MAX_ITEMS=5

# ---- Auth / subscription hook ----
# Set REQUIRE_API_KEY=true in production. Keys are comma separated.
REQUIRE_API_KEY=false
API_KEYS=
